{
  "name": "rubrist",
  "version": "0.3.0",
  "private": true,
  "description": "Governed evaluators and verifiable assessment evidence for AI systems.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luka-zivkovic/rubrist.git"
  },
  "bugs": {
    "url": "https://github.com/luka-zivkovic/rubrist/issues"
  },
  "homepage": "https://github.com/luka-zivkovic/rubrist",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test tools/*.test.mjs tools/ci/*.test.mjs tools/mcp/*.test.mjs tools/typesafe-loop/*.test.mjs tools/typesafe-loop/writing/*.test.mjs",
    "test:pg": "tsx tools/test-postgres.ts",
    "repository-boundaries": "node tools/repository-boundaries.mjs",
    "shared-contracts": "tsc -b packages/shared/tsconfig.json --force && node tools/shared-contracts.mjs",
    "large-files": "node tools/large-files.mjs",
    "clean": "rm -rf apps/*/dist apps/*/dist-ts packages/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo .turbo coverage out",
    "dev:api": "pnpm --filter @rubrist/api dev",
    "dev:web": "pnpm --filter @rubrist/web dev",
    "sim:prelude": "node tools/sim/prelude.mjs",
    "sim:checks": "playwright test",
    "typesafe-loop": "node tools/typesafe-loop/run.mjs",
    "typesafe-autoloop": "node tools/typesafe-loop/autoloop.mjs",
    "typesafe-writing-corpus": "node tools/typesafe-loop/writing/build-corpus.mjs",
    "typesafe-writing-suite": "node tools/typesafe-loop/writing/build-suite.mjs",
    "typesafe-skilloop": "node tools/typesafe-loop/writing/skilloop.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "jsdom": "^30.0.1",
    "pg": "^8.20.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "esbuild@0.18.20": "0.25.12"
    }
  }
}
