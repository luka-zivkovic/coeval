    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rubrist/shared": "workspace:*",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
