# API
PORT=8787
TRUSTED_ORIGINS=http://localhost:5173

# Postgres enables real repository + Better Auth. Omit for demo fixtures.
DATABASE_URL=postgres://coeval:coeval@localhost:5432/coeval

# Optional: enables Postgres smoke/auth integration tests.
PG_SMOKE_DATABASE_URL=postgres://coeval:coeval@localhost:5432/coeval

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
# Set to 1 only when direct API access is blocked by a trusted reverse proxy.
# Bootstrap rate limiting will then use that proxy's client-IP headers.
COEVAL_TRUST_PROXY=0

# Optional advanced headless fallback for POST /api/v1/bootstrap. Normal
# onboarding uses a short-lived pairing created in the signed-in UI instead.
# Generate a separate random value of at least 32 characters; do not reuse a key.
COEVAL_BOOTSTRAP_TOKEN=

# Optional platform judge-provider credentials. Project owners can instead
# save project-scoped encrypted keys in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=

# Optional integration poller cadence overrides.
LANGSMITH_POLL_INTERVAL_MS=
LANGSMITH_POLL_IMPORT_LIMIT=
LANGFUSE_POLL_INTERVAL_MS=
LANGFUSE_POLL_IMPORT_LIMIT=
